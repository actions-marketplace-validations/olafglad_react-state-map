{
  "name": "@react-state-map/core",
  "version": "0.3.1",
  "description": "Static analysis engine for React: knows where every prop comes from. Import-aware component graph, prop tracing, impact analysis, prop-drilling and Next.js Server Component diagnostics, and safe lift-to-context refactors.",
  "license": "MIT",
  "author": "Olaf Glad",
  "repository": {
    "type": "git",
    "url": "https://github.com/olafglad/react-state-map",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/graph/query.d.ts",
      "default": "./dist/graph/query.js"
    },
    "./package.json": "./package.json",
    "./format": {
      "types": "./dist/format/llm.d.ts",
      "default": "./dist/format/llm.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "tsc && node --test test/*.test.mjs"
  },
  "dependencies": {
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "static-analysis",
    "prop-drilling",
    "context",
    "state-management",
    "impact-analysis",
    "codemod",
    "refactor",
    "nextjs",
    "server-components",
    "react-19",
    "typescript",
    "ast",
    "zustand",
    "redux",
    "tanstack-query",
    "jotai",
    "mcp"
  ],
  "homepage": "https://github.com/olafglad/react-state-map/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/olafglad/react-state-map/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
