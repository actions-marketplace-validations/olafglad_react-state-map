{
  "name": "@react-state-map/cli",
  "version": "0.3.2",
  "description": "Know where every prop comes from — MCP server for Claude Code, Cursor & Copilot, a CI check with GitHub annotations, one-command prop-drilling fixes, and an interactive React state graph.",
  "type": "module",
  "license": "MIT",
  "author": "Olaf Glad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olafglad/react-state-map.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/olafglad/react-state-map/tree/main/packages/cli#readme",
  "bin": {
    "react-state-map": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && cp src/renderers/dagre.bundle.js src/renderers/elk.bundle.js src/renderers/cytoscape.bundle.js dist/renderers/",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@react-state-map/core": "workspace:*",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "cytoscape": "^3.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "state",
    "visualization",
    "static-analysis",
    "cli",
    "react-hooks",
    "prop-drilling",
    "state-management",
    "graph",
    "elkjs",
    "cytoscape",
    "context",
    "redux",
    "zustand",
    "component-diagram",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "ci",
    "github-action",
    "sarif",
    "nextjs",
    "react-server-components"
  ],
  "bugs": {
    "url": "https://github.com/olafglad/react-state-map/issues"
  }
}
